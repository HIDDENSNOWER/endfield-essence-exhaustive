{
    "name": "endfield-essence-exhaustive",
    "private": true,
    "version": "0.9.18",
    "description": "EEE · 终末地基质穷举数据记录与统计工具",
    "scripts": {
        "lint": "eslint js/ bump-version.js",
        "lint:fix": "eslint js/ bump-version.js --fix",
        "format": "prettier --write \"js/**/*.js\"",
        "format:check": "prettier --check \"js/**/*.js\"",
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage",
        "prepare": "husky"
    },
    "lint-staged": {
        "js/**/*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "eslint": "^9.15.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^15.5.2",
        "prettier": "^3.3.3"
    },
    "engines": {
        "node": ">=18.18"
    }
}
